<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Untuk Lintang, Semestaku — Dari Angga</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Great Vibes, Dancing Script, Cormorant Garamond, Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Dancing+Script:wght@600;700&family=Great+Vibes&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- GSAP for smooth animations -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        rose: {
                            50: '#fff1f2',
                            100: '#ffe4e6',
                            200: '#fecdd3',
                            300: '#fda4af',
                            400: '#fb7185',
                            500: '#f43f5e',
                            600: '#e11d48',
                            900: '#4c0519',
                        },
                        velvet: {
                            deep: '#2b0716',
                            night: '#19030c',
                            glow: '#ff4d8d'
                        }
                    },
                    fontFamily: {
                        script: ['Great Vibes', 'cursive'],
                        dancing: ['Dancing Script', 'cursive'],
                        serif: ['Cormorant Garamond', 'serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom Styles & Visual Effects */
        body {
            background-color: #16020b;
            color: #ffe4e6;
            overflow-x: hidden;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* Glassmorphism */
        .glass-card {
            background: rgba(255, 240, 245, 0.05);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 182, 193, 0.18);
            box-shadow: 0 8px 32px 0 rgba(255, 77, 141, 0.15);
        }

        .glass-card-hover {
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glass-card-hover:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 20px 40px 0 rgba(255, 77, 141, 0.35);
            border-color: rgba(255, 105, 180, 0.4);
        }

        /* Neon Glow Effects */
        .text-glow-pink {
            text-shadow: 0 0 10px rgba(255, 105, 180, 0.7), 0 0 20px rgba(255, 20, 147, 0.5), 0 0 30px rgba(255, 105, 180, 0.3);
        }
        .text-glow-gold {
            text-shadow: 0 0 10px rgba(255, 215, 0, 0.7), 0 0 20px rgba(255, 182, 193, 0.5);
        }
        .box-glow {
            box-shadow: 0 0 25px rgba(244, 63, 94, 0.4);
        }

        /* Ambient floating animation */
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-15px) rotate(3deg); }
        }
        .animate-float {
            animation: float 6s ease-in-out infinite;
        }

        @keyframes pulse-slow {
            0%, 100% { transform: scale(1); opacity: 0.8; }
            50% { transform: scale(1.08); opacity: 1; }
        }
        .animate-pulse-slow {
            animation: pulse-slow 3s ease-in-out infinite;
        }

        /* 3D Flip Card */
        .flip-card {
            perspective: 1000px;
        }
        .flip-card-inner {
            transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            transform-style: preserve-3d;
        }
        .flip-card:hover .flip-card-inner, .flip-card.flipped .flip-card-inner {
            transform: rotateY(180deg);
        }
        .flip-card-front, .flip-card-back {
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }
        .flip-card-back {
            transform: rotateY(180deg);
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #19030c;
        }
        ::-webkit-scrollbar-thumb {
            background: #fb7185;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #f43f5e;
        }

        /* Letter Envelope Animation */
        .envelope-wrapper {
            perspective: 1000px;
        }
        .envelope {
            transform-style: preserve-3d;
            transition: all 0.6s ease;
        }

        /* Glowing background gradient */
        .bg-romantic-gradient {
            background: radial-gradient(circle at 50% 50%, #3b091f 0%, #1a030c 70%, #0d0106 100%);
        }
    </style>
</head>
<body class="bg-romantic-gradient text-rose-100 min-h-screen relative selection:bg-rose-500 selection:text-white">

    <!-- Interactive Canvas for Floating Petals and Glowing Hearts -->
    <canvas id="bgCanvas" class="fixed top-0 left-0 w-full h-full pointer-events-none z-0"></canvas>

    <!-- Music Player Toggle Button -->
    <div class="fixed top-6 right-6 z-50">
        <button id="musicBtn" onclick="toggleAudio()" class="glass-card px-4 py-3 rounded-full flex items-center gap-3 border border-rose-400/40 hover:border-rose-400 transition-all duration-300 group shadow-lg hover:shadow-rose-500/30">
            <span class="relative flex h-3 w-3">
              <span id="musicPing" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75 hidden"></span>
              <span id="musicDot" class="relative inline-flex rounded-full h-3 w-3 bg-rose-500"></span>
            </span>
            <i id="musicIcon" class="fas fa-music text-rose-300 group-hover:scale-110 transition-transform"></i>
            <span id="musicText" class="text-xs font-medium tracking-wider uppercase text-rose-200">Musik Cinta</span>
        </button>
    </div>

    <!-- MAIN CONTAINER -->
    <main class="relative z-10">

        <!-- 1. LANDING HERO SECTION -->
        <section class="min-h-screen flex flex-col items-center justify-center text-center px-4 relative overflow-hidden">
            <!-- Decorative Glow Orbs -->
            <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-rose-600/20 rounded-full blur-3xl pointer-events-none animate-pulse-slow"></div>
            
            <div class="space-y-6 max-w-4xl mx-auto z-10">
                <div class="inline-block animate-float">
                    <span class="px-5 py-2 rounded-full glass-card text-rose-300 text-sm font-medium tracking-widest uppercase border border-rose-400/30">
                        <i class="fas fa-heart text-rose-400 mr-2 animate-pulse"></i> Spesial Untukmu, Lintang
                    </span>
                </div>

                <h1 class="font-script text-6xl md:text-8xl lg:text-9xl text-transparent bg-clip-text bg-gradient-to-r from-rose-200 via-pink-300 to-rose-400 text-glow-pink py-2">
                    Untuk Lintang, Semestaku...
                </h1>

                <p class="font-serif italic text-xl md:text-3xl text-rose-200/90 max-w-2xl mx-auto font-light leading-relaxed">
                    "Dari Angga, yang selalu menemukan alasan untuk mencintaimu di setiap detikan waktu dan hembusan nafas."
                </p>

                <div class="pt-8">
                    <a href="#constellation" class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-gradient-to-r from-rose-500 to-pink-600 text-white font-semibold text-lg shadow-lg hover:shadow-rose-500/50 hover:scale-105 transition-all duration-300 border border-rose-300/40 group">
                        <span>Buka Pintu Rahasia Cinta Kita</span>
                        <i class="fas fa-key group-hover:rotate-45 transition-transform duration-300 text-rose-200"></i>
                    </a>
                </div>
            </div>

            <!-- Scroll Indicator -->
            <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-center opacity-70 hover:opacity-100 transition-opacity">
                <p class="text-xs font-light tracking-widest text-rose-300 uppercase mb-2">Gulir Ke Bawah</p>
                <i class="fas fa-chevron-down animate-bounce text-rose-400"></i>
            </div>
        </section>


        <!-- 2. LIVE LOVE TIMER COUNTER -->
        <section class="py-16 px-4">
            <div class="max-w-5xl mx-auto glass-card rounded-3xl p-8 md:p-12 border border-rose-400/30 relative overflow-hidden box-glow">
                <div class="text-center space-y-4 mb-10">
                    <h2 class="font-dancing text-4xl md:text-5xl text-rose-300 text-glow-pink">Waktu Indah Bersamamu</h2>
                    <p class="text-rose-200/80 font-light text-sm md:text-base">Setiap detik bersamamu adalah anugerah terbesar dalam hidup Angga.</p>
                </div>

                <!-- Counter Grid -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 text-center">
                    <div class="glass-card p-6 rounded-2xl border border-rose-300/20 hover:border-rose-400/40 transition-all">
                        <span id="days" class="block font-bold text-4xl md:text-6xl text-transparent bg-clip-text bg-gradient-to-b from-white to-rose-200 font-serif">00</span>
                        <span class="text-xs uppercase tracking-widest text-rose-300/80 mt-2 block">Hari Menyatu</span>
                    </div>
                    <div class="glass-card p-6 rounded-2xl border border-rose-300/20 hover:border-rose-400/40 transition-all">
                        <span id="hours" class="block font-bold text-4xl md:text-6xl text-transparent bg-clip-text bg-gradient-to-b from-white to-rose-200 font-serif">00</span>
                        <span class="text-xs uppercase tracking-widest text-rose-300/80 mt-2 block">Jam Penuh Cinta</span>
                    </div>
                    <div class="glass-card p-6 rounded-2xl border border-rose-300/20 hover:border-rose-400/40 transition-all">
                        <span id="minutes" class="block font-bold text-4xl md:text-6xl text-transparent bg-clip-text bg-gradient-to-b from-white to-rose-200 font-serif">00</span>
                        <span class="text-xs uppercase tracking-widest text-rose-300/80 mt-2 block">Menit Berharga</span>
                    </div>
                    <div class="glass-card p-6 rounded-2xl border border-rose-300/20 hover:border-rose-400/40 transition-all">
                        <span id="seconds" class="block font-bold text-4xl md:text-6xl text-rose-400 font-serif animate-pulse">00</span>
                        <span class="text-xs uppercase tracking-widest text-rose-300/80 mt-2 block">Detik Berdetik</span>
                    </div>
                </div>

                <!-- Dynamic Romantic Quote -->
                <div class="mt-8 text-center pt-6 border-t border-rose-500/20">
                    <p id="dynamicQuote" class="font-serif italic text-lg text-rose-200 transition-opacity duration-500">
                        "Di antara jutaan bintang di alam semesta, mata Angga hanya tertuju padamu, Lintang."
                    </p>
                </div>
            </div>
        </section>


        <!-- 3. INTERACTIVE CONSTELLATION OF MEMORIES -->
        <section id="constellation" class="py-20 px-4 relative">
            <div class="max-w-6xl mx-auto">
                <div class="text-center space-y-3 mb-12">
                    <span class="text-rose-400 font-semibold tracking-widest uppercase text-xs">Peta Angkasa Perasaan</span>
                    <h2 class="font-script text-5xl md:text-7xl text-rose-200 text-glow-pink">Rasi Bintang Cinta Angga & Lintang</h2>
                    <p class="text-rose-300/80 font-light max-w-xl mx-auto">
                        Klik pada bintang-bintang bercahaya di bawah ini untuk mengumpulkan serpihan kenangan dan janji suci kita.
                    </p>
                </div>

                <!-- Interactive Star Map Box -->
                <div class="relative w-full h-[500px] glass-card rounded-3xl overflow-hidden border border-rose-500/30 flex items-center justify-center">
                    <!-- SVG Constellation Canvas -->
                    <svg id="starMap" class="w-full h-full absolute inset-0 cursor-pointer">
                        <!-- Lines connecting stars will be rendered here by JavaScript -->
                    </svg>

                    <!-- Hint Overlay -->
                    <div class="absolute top-4 left-4 pointer-events-none bg-rose-950/60 backdrop-blur-md px-4 py-2 rounded-full border border-rose-400/30 text-xs text-rose-300">
                        <i class="fas fa-sparkles text-yellow-300 mr-2"></i>Sentuh Bintang Untuk Membuka Pesan
                    </div>
                </div>
            </div>
        </section>


        <!-- 4. REASONS WHY LINTANG IS SPECIAL (3D GLASS CARDS) -->
        <section class="py-20 px-4 bg-gradient-to-b from-transparent via-rose-950/20 to-transparent">
            <div class="max-w-6xl mx-auto">
                <div class="text-center space-y-3 mb-16">
                    <span class="text-rose-400 font-semibold tracking-widest uppercase text-xs">Alasan Hati Ini Memilihmu</span>
                    <h2 class="font-dancing text-4xl md:text-6xl text-rose-200">Mengapa Lintang Begitu Istimewa?</h2>
                    <p class="text-rose-300/80 font-light">Sentuh atau sorot kartu di bawah ini untuk melihat alasan mendalam dari hati Angga.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Card 1 -->
                    <div class="flip-card h-80 rounded-2xl cursor-pointer">
                        <div class="flip-card-inner w-full h-full relative rounded-2xl shadow-xl">
                            <!-- Front -->
                            <div class="flip-card-front absolute inset-0 glass-card rounded-2xl p-8 flex flex-col items-center justify-center text-center border border-rose-400/30">
                                <div class="w-16 h-16 rounded-full bg-rose-500/20 flex items-center justify-center text-rose-300 text-3xl mb-6 box-glow">
                                    <i class="fas fa-smile-beam"></i>
                                </div>
                                <h3 class="font-serif text-2xl text-rose-100 font-semibold mb-2">Senyummu yang Menghangatkan</h3>
                                <p class="text-rose-300/70 text-sm font-light">Setiap kali Lintang tersenyum, dunia Angga terasa jauh lebih indah...</p>
                                <span class="mt-6 text-xs text-rose-400 flex items-center gap-2"><i class="fas fa-redo"></i> Putar Kartu</span>
                            </div>
                            <!-- Back -->
                            <div class="flip-card-back absolute inset-0 glass-card bg-rose-950/90 rounded-2xl p-8 flex flex-col items-center justify-center text-center border border-rose-400/50">
                                <h4 class="font-dancing text-2xl text-rose-300 mb-4">Kehangatan Jiwa</h4>
                                <p class="text-rose-100/90 font-serif italic text-base leading-relaxed">
                                    "Senyuman Lintang adalah obat paling mujarab untuk segala lelah Angga. Di dalam senyummu, Angga menemukan kedamaian rumah."
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Card 2 -->
                    <div class="flip-card h-80 rounded-2xl cursor-pointer">
                        <div class="flip-card-inner w-full h-full relative rounded-2xl shadow-xl">
                            <!-- Front -->
                            <div class="flip-card-front absolute inset-0 glass-card rounded-2xl p-8 flex flex-col items-center justify-center text-center border border-rose-400/30">
                                <div class="w-16 h-16 rounded-full bg-rose-500/20 flex items-center justify-center text-rose-300 text-3xl mb-6 box-glow">
                                    <i class="fas fa-heart-pulse"></i>
                                </div>
                                <h3 class="font-serif text-2xl text-rose-100 font-semibold mb-2">Tulusnya Hatimu</h3>
                                <p class="text-rose-300/70 text-sm font-light">Kebaikan dan ketulusan cara Lintang memperlakukan Angga...</p>
                                <span class="mt-6 text-xs text-rose-400 flex items-center gap-2"><i class="fas fa-redo"></i> Putar Kartu</span>
                            </div>
                            <!-- Back -->
                            <div class="flip-card-back absolute inset-0 glass-card bg-rose-950/90 rounded-2xl p-8 flex flex-col items-center justify-center text-center border border-rose-400/50">
                                <h4 class="font-dancing text-2xl text-rose-300 mb-4">Ketulusan Tanpa Batas</h4>
                                <p class="text-rose-100/90 font-serif italic text-base leading-relaxed">
                                    "Lintang mengajarkan Angga arti mencintai tanpa syarat. Hati Lintang yang begitu lembut dan penuh perhatian adalah harta terindah yang Angga miliki."
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Card 3 -->
                    <div class="flip-card h-80 rounded-2xl cursor-pointer">
                        <div class="flip-card-inner w-full h-full relative rounded-2xl shadow-xl">
                            <!-- Front -->
                            <div class="flip-card-front absolute inset-0 glass-card rounded-2xl p-8 flex flex-col items-center justify-center text-center border border-rose-400/30">
                                <div class="w-16 h-16 rounded-full bg-rose-500/20 flex items-center justify-center text-rose-300 text-3xl mb-6 box-glow">
                                    <i class="fas fa-infinity"></i>
                                </div>
                                <h3 class="font-serif text-2xl text-rose-100 font-semibold mb-2">Masa Depan Bersama</h3>
                                <p class="text-rose-300/70 text-sm font-light">Mimpi-mimpi indah yang ingin Angga rajut bersama Lintang...</p>
                                <span class="mt-6 text-xs text-rose-400 flex items-center gap-2"><i class="fas fa-redo"></i> Putar Kartu</span>
                            </div>
                            <!-- Back -->
                            <div class="flip-card-back absolute inset-0 glass-card bg-rose-950/90 rounded-2xl p-8 flex flex-col items-center justify-center text-center border border-rose-400/50">
                                <h4 class="font-dancing text-2xl text-rose-300 mb-4">Abadi Dalam Waktu</h4>
                                <p class="text-rose-100/90 font-serif italic text-base leading-relaxed">
                                    "Bersama Lintang, Angga tidak takut menatap hari esok. Angga ingin berjalan bergandengan tangan menembus segala waktu dan cerita kehidupan."
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <!-- 5. SECRET LOVE LETTER ENVELOPE -->
        <section class="py-20 px-4 relative">
            <div class="max-w-3xl mx-auto text-center space-y-6">
                <span class="text-rose-400 font-semibold tracking-widest uppercase text-xs">Pesan Tersembunyi Dari Hati</span>
                <h2 class="font-script text-5xl md:text-7xl text-rose-200 text-glow-pink">Surat Cinta Angga Untuk Lintang</h2>
                <p class="text-rose-300/80 font-light">Klik amplop di bawah ini untuk membuka lembaran rasa yang dituliskan dengan penuh ketulusan.</p>

                <!-- Envelope Wrapper -->
                <div class="pt-8 flex justify-center">
                    <div id="envelope" onclick="openLetter()" class="w-72 h-48 md:w-96 md:h-64 glass-card bg-rose-900/40 rounded-2xl border-2 border-rose-400/50 flex flex-col items-center justify-center cursor-pointer hover:scale-105 transition-all duration-300 group shadow-2xl relative">
                        <div class="w-16 h-16 rounded-full bg-rose-600/30 border border-rose-400 flex items-center justify-center text-rose-200 text-2xl group-hover:scale-110 transition-transform box-glow">
                            <i class="fas fa-envelope-open-text"></i>
                        </div>
                        <span class="mt-4 font-dancing text-2xl text-rose-200">Untuk Lintang Pertamaku</span>
                        <span class="text-xs text-rose-300/70 mt-1">Sentuh Untuk Membuka</span>
                    </div>
                </div>
            </div>
        </section>


        <!-- 6. SURPRISE BUTTON FOR MISSING MOMENTS -->
        <section class="py-20 px-4 text-center relative mb-12">
            <div class="max-w-2xl mx-auto space-y-6 glass-card p-10 rounded-3xl border border-rose-400/30">
                <i class="fas fa-heart text-5xl text-rose-500 animate-pulse"></i>
                <h3 class="font-dancing text-4xl text-rose-200">Sedang Merindukan Angga?</h3>
                <p class="text-rose-300/80 font-light text-sm md:text-base">
                    Jika detik ini Lintang sedang merindukan Angga, tekan tombol di bawah ini dan biarkan kasih sayang Angga memeluk hatimu.
                </p>
                <button onclick="triggerSurprise()" class="px-8 py-4 rounded-full bg-gradient-to-r from-pink-500 via-rose-500 to-red-500 text-white font-bold text-lg shadow-xl hover:shadow-rose-500/60 hover:scale-110 active:scale-95 transition-all duration-300 border border-rose-200/40">
                    <i class="fas fa-sparkles mr-2"></i> Tekan Ini Saat Kamu Merindu <i class="fas fa-heart ml-2"></i>
                </button>
            </div>
        </section>

        <!-- FOOTER -->
        <footer class="py-8 text-center text-rose-400/60 text-xs border-t border-rose-900/30 font-light">
            <p>Dibuat dengan segenap cinta yang tak terhingga oleh <strong class="text-rose-300 font-normal">Angga</strong> khusus untuk <strong class="text-rose-300 font-normal">Lintang</strong> ❤️</p>
        </footer>

    </main>


    <!-- MODAL POPUP FOR CONSTELLATION MEMORIES -->
    <div id="memoryModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-4">
        <div class="glass-card max-w-lg w-full p-8 rounded-3xl border border-rose-400/50 relative animate-float">
            <button onclick="closeModal('memoryModal')" class="absolute top-4 right-4 text-rose-400 hover:text-white text-xl w-10 h-10 rounded-full bg-rose-950/50 flex items-center justify-center">
                <i class="fas fa-times"></i>
            </button>
            <div class="text-center space-y-4">
                <div class="w-14 h-14 rounded-full bg-rose-500/20 text-rose-300 flex items-center justify-center text-2xl mx-auto border border-rose-400/40">
                    <i id="modalIcon" class="fas fa-star"></i>
                </div>
                <h3 id="modalTitle" class="font-script text-4xl text-rose-200">Judul Bintang</h3>
                <p id="modalText" class="font-serif italic text-rose-100 text-lg leading-relaxed">Pesan dari Angga akan muncul di sini...</p>
                <div class="pt-4">
                    <button onclick="closeModal('memoryModal')" class="px-6 py-2 rounded-full bg-rose-600/80 hover:bg-rose-600 text-white text-sm font-medium transition-colors">
                        Simpan di Hati
                    </button>
                </div>
            </div>
        </div>
    </div>


    <!-- MODAL POPUP FOR FULL LOVE LETTER -->
    <div id="letterModal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-lg hidden flex items-center justify-center p-4 overflow-y-auto">
        <div class="glass-card bg-rose-950/90 max-w-2xl w-full p-8 md:p-12 rounded-3xl border border-rose-400/60 relative my-8 shadow-2xl">
            <button onclick="closeModal('letterModal')" class="absolute top-4 right-4 text-rose-400 hover:text-white text-xl w-10 h-10 rounded-full bg-rose-900/50 flex items-center justify-center">
                <i class="fas fa-times"></i>
            </button>
            
            <div class="space-y-6 text-left">
                <div class="border-b border-rose-500/30 pb-4 text-center">
                    <h3 class="font-script text-5xl text-rose-300 text-glow-pink">Untuk Lintang Tersayang,</h3>
                    <p class="text-xs uppercase tracking-widest text-rose-400/80 mt-1">Dari Angga yang Selalu Mencintaimu</p>
                </div>

                <div class="font-serif text-lg md:text-xl text-rose-100/90 space-y-4 leading-relaxed italic font-light">
                    <p>
                        Lintang... Jika ada hal terbaik yang pernah terjadi dalam hidup Angga, itu adalah kebetulan indah saat takdir mempertemukan Angga denganmu.
                    </p>
                    <p>
                        Kamu bukan hanya sekadar seseorang yang Angga cintai, tetapi kamu adalah rumah, tempat Angga pulang, dan alasan mengapa Angga selalu ingin menjadi pribadi yang lebih baik setiap harinya.
                    </p>
                    <p>
                        Tawa bersamamu adalah melodi terindah, dan setiap momen yang kita lewati—baik yang sederhana maupun yang penuh makna—tersimpan rapi di dalam sudut hati Angga yang paling dalam.
                    </p>
                    <p>
                        Terima kasih telah hadir dan menerangi dunia Angga sebagaimana bintang Lintang yang selalu bersinar terang di angkasa. Angga berjanji akan selalu menjaga, menyayangi, dan mendampingimu di setiap langkah kehidupan kita.
                    </p>
                </div>

                <div class="pt-6 border-t border-rose-500/30 text-right">
                    <p class="font-dancing text-3xl text-rose-300">Dengan Seluruh Cinta,</p>
                    <p class="font-script text-4xl text-rose-200 mt-2">Angga</p>
                </div>
            </div>
        </div>
    </div>


    <!-- JAVASCRIPT CODE -->
    <script>
        /* ==========================================
           1. BACKGROUND CANVAS ANIMATION (PETALS & HEARTS)
           ========================================== */
        const canvas = document.getElementById('bgCanvas');
        const ctx = canvas.getContext('2d');

        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        });

        class Particle {
            constructor() {
                this.reset();
            }

            reset() {
                this.x = Math.random() * width;
                this.y = Math.random() * height - height;
                this.size = Math.random() * 12 + 6;
                this.speedY = Math.random() * 1.5 + 0.8;
                this.speedX = Math.sin(Math.random() * Math.PI) * 1;
                this.rotation = Math.random() * 360;
                this.rotationSpeed = (Math.random() - 0.5) * 2;
                this.opacity = Math.random() * 0.7 + 0.3;
                this.type = Math.random() > 0.4 ? 'petal' : 'heart';
            }

            update() {
                this.y += this.speedY;
                this.x += Math.sin(this.y * 0.01) * 0.8;
                this.rotation += this.rotationSpeed;

                if (this.y > height + 20) {
                    this.reset();
                    this.y = -20;
                }
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate((this.rotation * Math.PI) / 180);
                ctx.globalAlpha = this.opacity;

                if (this.type === 'petal') {
                    // Draw Rose Petal
                    ctx.fillStyle = '#fb7185';
                    ctx.beginPath();
                    ctx.moveTo(0, 0);
                    ctx.bezierCurveTo(-this.size, -this.size / 2, -this.size, this.size, 0, this.size);
                    ctx.bezierCurveTo(this.size, this.size, this.size, -this.size / 2, 0, 0);
                    ctx.fill();
                } else {
                    // Draw Glowing Heart
                    ctx.fillStyle = '#f43f5e';
                    ctx.shadowColor = '#ff4d8d';
                    ctx.shadowBlur = 10;
                    ctx.beginPath();
                    let topCurveHeight = this.size * 0.3;
                    ctx.moveTo(0, topCurveHeight);
                    ctx.bezierCurveTo(0, 0, -this.size / 2, 0, -this.size / 2, topCurveHeight);
                    ctx.bezierCurveTo(-this.size / 2, (this.size + topCurveHeight) / 2, 0, this.size, 0, this.size);
                    ctx.bezierCurveTo(0, this.size, this.size / 2, (this.size + topCurveHeight) / 2, this.size / 2, topCurveHeight);
                    ctx.bezierCurveTo(this.size / 2, 0, 0, 0, 0, topCurveHeight);
                    ctx.fill();
                }

                ctx.restore();
            }
        }

        const particles = Array.from({ length: 45 }, () => new Particle());

        function animateParticles() {
            ctx.clearRect(0, 0, width, height);
            particles.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animateParticles);
        }
        animateParticles();


        /* ==========================================
           2. LIVE LOVE TIMER COUNTER
           ========================================== */
        // Tanggal Kebersamaan (Bisa disesuaikan, misal 1 Januari 2024 atau tanggal jadian)
        const startDate = new Date('2024-01-01T00:00:00');

        function updateCounter() {
            const now = new Date();
            const diff = now - startDate;

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
            const minutes = Math.floor((diff / (1000 * 60)) % 60);
            const seconds = Math.floor((diff / 1000) % 60);

            document.getElementById('days').innerText = String(days).padStart(2, '0');
            document.getElementById('hours').innerText = String(hours).padStart(2, '0');
            document.getElementById('minutes').innerText = String(minutes).padStart(2, '0');
            document.getElementById('seconds').innerText = String(seconds).padStart(2, '0');
        }
        setInterval(updateCounter, 1000);
        updateCounter();

        // Dynamic Quotes Switcher
        const romanticQuotes = [
            '"Di antara jutaan bintang di alam semesta, mata Angga hanya tertuju padamu, Lintang."',
            '"Menikmati waktu bersamamu adalah hobi favorit Angga yang tak pernah membosankan."',
            '"Lintang adalah tempat teduh di saat dunia Angga terasa terlalu bising."',
            '"Bagi Angga, setiap hari bersamamu adalah hari favorit Angga dalam setahun."'
        ];
        let quoteIndex = 0;
        setInterval(() => {
            const quoteElem = document.getElementById('dynamicQuote');
            quoteElem.style.opacity = '0';
            setTimeout(() => {
                quoteIndex = (quoteIndex + 1) % romanticQuotes.length;
                quoteElem.innerText = romanticQuotes[quoteIndex];
                quoteElem.style.opacity = '1';
            }, 500);
        }, 6000);


        /* ==========================================
           3. CONSTELLATION OF MEMORIES (STAR MAP)
           ========================================== */
        const starsData = [
            { id: 1, x: 20, y: 30, title: "Awal Mula Cerita", text: "Saat pertama kali Angga mengenal Lintang, Angga tahu ada sesuatu yang istimewa yang akan mengubah hidup Angga selamanya.", icon: "fa-star" },
            { id: 2, x: 40, y: 70, title: "Tawa Pertamamu", text: "Suara tawamu saat itu masih terekam jelas di ingatan Angga. Itu adalah suara paling menyenangkan yang pernah Angga dengar.", icon: "fa-face-smile-beam" },
            { id: 3, x: 50, y: 25, title: "Pusat Semestaku", text: "Kamu adalah pusat dari segala doa-doa baik yang selalu Angga langitkan setiap malam.", icon: "fa-heart" },
            { id: 4, x: 65, y: 75, title: "Pelukan Hangat", text: "Di manapun kita berada, berada di sisimu selalu membuat Angga merasa aman dan tenang.", icon: "fa-hand-holding-heart" },
            { id: 5, x: 82, y: 35, title: "Janji Angga", text: "Angga berjanji akan selalu ada untuk Lintang, mendukung mimpi-mimpimu, dan menggenggam erat tanganmu selamanya.", icon: "fa-ring" }
        ];

        const svgMap = document.getElementById('starMap');

        function renderConstellation() {
            svgMap.innerHTML = '';

            // Draw Lines connecting stars
            for (let i = 0; i < starsData.length - 1; i++) {
                const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
                line.setAttribute("x1", `${starsData[i].x}%`);
                line.setAttribute("y1", `${starsData[i].y}%`);
                line.setAttribute("x2", `${starsData[i+1].x}%`);
                line.setAttribute("y2", `${starsData[i+1].y}%`);
                line.setAttribute("stroke", "rgba(251, 113, 133, 0.4)");
                line.setAttribute("stroke-width", "2");
                line.setAttribute("stroke-dasharray", "4");
                svgMap.appendChild(line);
            }

            // Draw Stars
            starsData.forEach(star => {
                const g = document.createElementNS("http://www.w3.org/2000/svg", "g");
                g.setAttribute("class", "cursor-pointer group");
                g.onclick = () => showMemoryModal(star);

                // Outer Glow Circle
                const glow = document.createElementNS("http://www.w3.org/2000/svg", "circle");
                glow.setAttribute("cx", `${star.x}%`);
                glow.setAttribute("cy", `${star.y}%`);
                glow.setAttribute("r", "18");
                glow.setAttribute("fill", "rgba(244, 63, 94, 0.2)");
                glow.setAttribute("class", "animate-ping opacity-75");

                // Core Star Circle
                const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
                circle.setAttribute("cx", `${star.x}%`);
                circle.setAttribute("cy", `${star.y}%`);
                circle.setAttribute("r", "8");
                circle.setAttribute("fill", "#ffd700");
                circle.setAttribute("stroke", "#ffffff");
                circle.setAttribute("stroke-width", "2");
                circle.setAttribute("class", "hover:scale-150 transition-transform duration-300");

                // Label Text
                const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
                text.setAttribute("x", `${star.x}%`);
                text.setAttribute("y", `${star.y + 7}%`);
                text.setAttribute("fill", "#ffe4e6");
                text.setAttribute("font-size", "12");
                text.setAttribute("text-anchor", "middle");
                text.setAttribute("class", "font-serif tracking-wider select-none");
                text.textContent = star.title;

                g.appendChild(glow);
                g.appendChild(circle);
                g.appendChild(text);
                svgMap.appendChild(g);
            });
        }
        renderConstellation();

        function showMemoryModal(star) {
            document.getElementById('modalTitle').innerText = star.title;
            document.getElementById('modalText').innerText = `"${star.text}"`;
            document.getElementById('modalIcon').className = `fas ${star.icon}`;
            document.getElementById('memoryModal').classList.remove('hidden');
        }

        function openLetter() {
            document.getElementById('letterModal').classList.remove('hidden');
            triggerConfetti();
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }


        /* ==========================================
           4. SURPRISE BUTTON & CONFETTI
           ========================================== */
        function triggerConfetti() {
            confetti({
                particleCount: 100,
                spread: 70,
                origin: { y: 0.6 },
                colors: ['#f43f5e', '#fb7185', '#ffd700', '#ffffff']
            });
        }

        function triggerSurprise() {
            triggerConfetti();
            
            // Multiple explosion effect
            setTimeout(() => {
                confetti({
                    particleCount: 80,
                    angle: 60,
                    spread: 55,
                    origin: { x: 0 }
                });
            }, 250);

            setTimeout(() => {
                confetti({
                    particleCount: 80,
                    angle: 120,
                    spread: 55,
                    origin: { x: 1 }
                });
            }, 400);

            // Pop up sweet toast message
            const toast = document.createElement('div');
            toast.className = 'fixed bottom-10 left-1/2 -translate-x-1/2 z-50 glass-card bg-rose-900/90 text-rose-100 px-8 py-4 rounded-full border border-rose-400 text-center shadow-2xl font-serif italic text-lg animate-bounce';
            toast.innerHTML = '<i class="fas fa-heart text-rose-400 mr-2"></i> Angga juga sangat merindukan Lintang saat ini! ❤️';
            document.body.appendChild(toast);

            setTimeout(() => {
                toast.remove();
            }, 4500);
        }


        /* ==========================================
           5. WEB AUDIO API ROMANTIC SYNTHESIZER
           ========================================== */
        let audioCtx = null;
        let isPlaying = false;
        let timerId = null;

        const melodyNotes = [
            { note: 261.63, duration: 0.8 }, // C4
            { note: 329.63, duration: 0.8 }, // E4
            { note: 392.00, duration: 0.8 }, // G4
            { note: 493.88, duration: 1.2 }, // B4
            { note: 440.00, duration: 0.8 }, // A4
            { note: 349.23, duration: 0.8 }, // F4
            { note: 329.63, duration: 1.5 }, // E4
        ];

        function playRomanticMelody() {
            if (!isPlaying) return;
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }

            let time = audioCtx.currentTime;
            melodyNotes.forEach(item => {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(item.note, time);

                gain.gain.setValueAtTime(0.01, time);
                gain.gain.exponentialRampToValueAtTime(0.15, time + 0.1);
                gain.gain.exponentialRampToValueAtTime(0.001, time + item.duration - 0.1);

                osc.connect(gain);
                gain.connect(audioCtx.destination);

                osc.start(time);
                osc.stop(time + item.duration);

                time += item.duration;
            });

            timerId = setTimeout(playRomanticMelody, 6500);
        }

        function toggleAudio() {
            const btn = document.getElementById('musicBtn');
            const icon = document.getElementById('musicIcon');
            const text = document.getElementById('musicText');
            const ping = document.getElementById('musicPing');

            if (!isPlaying) {
                isPlaying = true;
                playRomanticMelody();
                icon.className = "fas fa-volume-high text-rose-400";
                text.innerText = "Musik Nyala";
                ping.classList.remove('hidden');
                btn.classList.add('border-rose-400');
            } else {
                isPlaying = false;
                if (timerId) clearTimeout(timerId);
                icon.className = "fas fa-music text-rose-300";
                text.innerText = "Musik Cinta";
                ping.classList.add('hidden');
                btn.classList.remove('border-rose-400');
            }
        }
    </script>
